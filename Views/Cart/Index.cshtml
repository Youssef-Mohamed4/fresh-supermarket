@model IEnumerable<WebProject.Models.CartItem>
@{
    ViewData["Title"] = "Your Cart";
}

<div class="supermarket-card p-5 mt-5">
    <h2 class="text-primary fw-bold mb-4">Shopping Cart</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <p class="lead">Your cart is empty.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Start Shopping</a>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="fw-bold">@item.Product?.Name</span>
                            </td>
                            <td>$@item.Product?.Price.ToString("0.00")</td>
                            <td>@item.Quantity</td>
                            <td>$@((item.Product?.Price * item.Quantity)?.ToString("0.00"))</td>
                            <td class="text-end">
                                <form asp-action="RemoveFromCart" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end fw-bold">Grand Total:</td>
                        <td class="fw-bold product-price">$@Model.Sum(i => i.Product?.Price * i.Quantity)?.ToString("0.00")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="text-end mt-4">
            <form asp-action="Checkout" method="post">
                <button type="submit" class="btn btn-success btn-lg">Checkout</button>
            </form>
        </div>
    }
</div>
